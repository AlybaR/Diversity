{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "bundle:check": "cross-env EXPO_OFFLINE=1 CI=1 expo export --platform web --output-dir .test-build && rimraf .test-build",
    "build:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.11",
    "@react-native-async-storage/async-storage": "^3.0.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.100.11",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.13",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^55.0.23",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.469.0",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.21",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
