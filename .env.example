# Configuration Supabase pour Passerelle
# Copie ce fichier en `.env.local` (non versionné) et remplis avec tes valeurs.
#
# Récupère les valeurs depuis : https://app.supabase.com/project/<ton-projet>/settings/api
# Préfixe EXPO_PUBLIC_ obligatoire (sinon Expo n'expose pas la variable côté client).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
