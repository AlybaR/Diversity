# Configuration Supabase pour Passerelle
# Copie ce fichier en `.env.local` (non versionné) et remplis avec tes valeurs.
#
# Récupère les valeurs depuis : https://app.supabase.com/project/<ton-projet>/settings/api
# Préfixe EXPO_PUBLIC_ obligatoire (sinon Expo n'expose pas la variable côté client).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Bascule mock ↔ Supabase (Phase 2).
# - non défini ou autre que 'true'  : l'app utilise mockData en mémoire (dev local, tests E2E)
# - 'true'                          : l'app interroge Supabase + exige une auth magic link
# À activer une fois que tu as :
#   1. exécuté les migrations 0001 + 0002 + seed.sql + seed-test-user.sql
#   2. configuré Authentication > URL Configuration dans le dashboard Supabase
EXPO_PUBLIC_USE_SUPABASE=false

# Sentry (Phase 3) — monitoring d'erreurs côté client.
# Laisse vide pour désactiver (en dev, les logs Sentry passent par console).
# Quand tu auras créé ton compte Sentry (https://sentry.io, région EU), récupère le DSN
# dans Settings > Projects > <ton projet> > Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
